  "packageManager": "npm@11.17.0",
  "private": true,
  "scripts": {
    "build": "ng build \u0026\u0026 node scripts/post-build.js",
    "build:shared": "npm run build --prefix shared",
    "deploy:dryl": "python scripts/deploy-dryl.py",
    "deploy:pi-api": "python scripts/pi-install-planes-api.py --skip-nginx",
    "errors:probe:planes-api-env": "python3 scripts/probe-planes-api-env.py",
    "errors:probe:planes-kiosk-alert": "npm run verify:kiosk-alert",
    "install:kiosk-watch": "python scripts/pi-install-planes-kiosk.py",
    "kiosk:planes": "python scripts/pi-install-planes-kiosk.py --launch",
    "kiosk:restart": "python scripts/pi-restart-planes-kiosk.py",
    "lint:no-fcm-sw": "node scripts/check-no-fcm-sw.js",
    "lint:notification-delivery": "node scripts/check-notification-delivery.js",
    "ng": "ng",
    "prebuild": "npm run build:shared",
    "server": "node server.js",
    "start": "concurrently \"node server.js\" \"ng serve --host 0.0.0.0 --proxy-config proxy.conf.json\"",
    "test": "ng test",
    "verify:kiosk-alert": "python scripts/pi-install-planes-api.py --self-test \u0026\u0026 python scripts/mirror-kiosk/planes-kiosk-alert-listen.py --self-test \u0026\u0026 python scripts/verify-planes-kiosk-alert-chain.py",
    "verify:kiosk-motion": "python scripts/verify-planes-kiosk-motion.py",
    "verify:kiosk-recovery": "python scripts/verify-planes-kiosk-recovery.py",
    "verify:planes-api-env": "python3 scripts/pi-install-planes-api.py --self-test",
    "verify:prod-formatter": "python scripts/prove-prod-notification-formatter.py",
    "watch": "ng build --watch --configuration development"
  },
  "version": "2026.7.17"
}
