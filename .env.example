# Example environment file (local scripts + planes-api dev)
# Production secrets live in /home/pi/planes-api/.env on dryl-prod — do not overwrite from a laptop.
# Copy to .env for local use only. NEVER commit .env to git.

# Pushover API credentials (for test-pushover.js)
PUSHOVER_API_TOKEN=your_pushover_api_token_here
PUSHOVER_USER_KEY=your_pushover_user_key_here

# Shared secret so row.dryl.io can POST /notifyRowSession (never commit the real value)
ROW_SESSION_NOTIFY_SECRET=your_row_session_notify_secret_here

# Kiosk speaker is on magicmirror (.74). planes-api on dryl-prod POSTs this.
PLANES_KIOSK_PLAY_URL=http://192.168.178.74:8796/play
PLANES_KIOSK_PLAY_TOKEN=your_kiosk_play_token_here
