{
  "name": "plane-alert-functions",
  "version": "2026.7.17",
  "description": "Plane Alert Pi API (local JSON store only)",
  "main": "lib/pi-server.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "npm run build",
    "clean": "rimraf lib",
    "lint": "eslint --ext .ts src",
    "serve": "echo Use npm run start:pi (local planes API)",
    "start:pi": "node lib/pi-server.js",
    "deploy": "echo Use python scripts/pi-install-planes-api.py from plane-alert repo",
    "test": "npm run build && node --test lib/services/notification-delivery.test.js lib/services/device-registration-dedup.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@plane-alert/shared": "file:./shared-package",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "graphql": "^16.12.0",
    "i18n-iso-countries": "^7.14.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.7.2"
  }
}
