{
  "name": "plane-alert-functions",
  "version": "0.0.1",
  "description": "Firebase Cloud Functions for Plane Alert background notifications",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "npm run build",
    "clean": "rimraf lib",
    "lint": "eslint --ext .ts src",
    "serve": "firebase emulators:start --only functions",
    "start:pi": "node lib/pi-server.js",
    "deploy": "npm run clean && npm run build && firebase deploy --only functions"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@plane-alert/shared": "file:./shared-package",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.0.3",
    "graphql": "^16.12.0",
    "i18n-iso-countries": "^7.14.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.12.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.7.2"
  }
}
