[Unit]
Description=planes.dryl.io fullscreen kiosk
# Labwc / wayland must exist before Chromium --ozone-platform=wayland.
After=default.target
After=graphical-session.target
# Cap restart storms if wayland/GPU flaps (was unbounded every 20s).
StartLimitIntervalSec=300
StartLimitBurst=8

[Service]
Type=simple
Environment=PLANES_KIOSK_QUICK_START=1
Environment=PLANES_KIOSK_WAYLAND_WAIT=90
ExecStart=/home/pi/bin/planes-kiosk.sh
Restart=on-failure
RestartSec=20
TimeoutStopSec=15
# This Pi also runs balcony-log's real-time ffmpeg HLS pull — yield CPU/IO to
# it under contention rather than starving the stream (cgroup-level, on top
# of the nice/ionice the launcher applies to the chromium process itself).
CPUWeight=25
IOWeight=25

[Install]
WantedBy=default.target
