[Unit]
Description=Plane Alert API (Pushover + ADS-B on Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/planes-api
ExecStart=/usr/bin/node lib/pi-server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=-/home/pi/planes-api/.env
# dryl-prod (.79) has aplay only — no pw-play/paplay, no PipeWire sinks.
# Speaker is Jabra SPEAK 510 on magicmirror (.74). POST the LAN listener.
Environment=PLANES_KIOSK_PLAY_URL=http://192.168.178.74:8796/play

[Install]
WantedBy=multi-user.target
