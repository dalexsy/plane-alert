[Unit]
Description=Plane Alert API (Pushover + ADS-B on Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/planes-api
ExecStart=/usr/bin/node lib/pi-server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=-/home/pi/planes-api/.env
# Speaker is on magicmirror (.74). Prod POSTs the kiosk listener — do not
# treat local pw-play on this host as audible. Token lives in .env.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PLANES_KIOSK_PLAY_URL=http://192.168.178.74:8796/play
Environment=PLANES_KIOSK_ALERT_MP3=/home/pi/planes-api/assets/alerts/precious_little_life_forms.mp3

[Install]
WantedBy=multi-user.target
